{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dorostream-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dorostream",
      "database_id": "07253e9b-b424-442f-a29c-a19f112c9c4f",
      "migrations_dir": "migrations"
    }
  ]
}
